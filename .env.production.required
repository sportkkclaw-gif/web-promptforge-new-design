# ─────────────────────────────────────────────────────────────────────────────
# PromptForge Studio — Production Environment Variables Template
# Required for `npm run verify:cloud` (cloud readiness smoke harness)
# Fill in real values and rename to .env.production before deploying.
# ─────────────────────────────────────────────────────────────────────────────

# Database connection string (Postgres)
DATABASE_URL=postgresql://user:password@host:5432/promptforge

# Auth secret — random 256-bit string used for JWT/session signing
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Auth provider external URL (e.g., NextAuth endpoint or OAuth provider)
AUTH_URL=https://auth.promptforge.studio

# OpenAI API key — used for LLM template generation & evaluation
OPENAI_API_KEY=sk-

# Anthropic API key — used for Claude-powered features
ANTHROPIC_API_KEY=sk-ant-

# Stripe secret key — used for subscription billing & payment processing
STRIPE_SECRET_KEY=sk_live_

# Sentry DSN — error tracking & performance monitoring
SENTRY_DSN=https://example@sentry.io/1234567

# Elasticsearch URL — used for template search & autocomplete indexing
ELASTICSEARCH_URL=https://search.promptforge.studio:9200

# Elasticsearch API key — bearer token for ES index access
ELASTICSEARCH_API_KEY=

# Resend API key — transactional email delivery (auth, billing notifications)
RESEND_API_KEY=re_