# PromptForge Studio - Production Environment
# DO NOT commit actual secrets to version control
# Use CI/CD environment variables or a secrets manager

# ============================================================
# Application
# ============================================================
NEXT_PUBLIC_APP_URL="https://promptforge.studio"
NEXT_PUBLIC_APP_NAME="PromptForge Studio"
NODE_ENV="production"

# ============================================================
# Database
# ============================================================
DATABASE_URL="postgresql://prod_user:CHANGE_ME@prod-db-host:5432/promptforge"

# ============================================================
# Authentication
# ============================================================
AUTH_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_32"
AUTH_URL="https://promptforge.studio"
AUTH_GOOGLE_ID="CHANGE_ME"
AUTH_GOOGLE_SECRET="CHANGE_ME"
AUTH_GITHUB_ID="CHANGE_ME"
AUTH_GITHUB_SECRET="CHANGE_ME"

# ============================================================
# AI Providers (REAL - do not mock in production)
# ============================================================
OPENAI_API_KEY="CHANGE_ME"
ANTHROPIC_API_KEY="CHANGE_ME"
USE_MOCK_AI="false"

# ============================================================
# Stripe
# ============================================================
STRIPE_SECRET_KEY="CHANGE_ME"
STRIPE_WEBHOOK_SECRET="CHANGE_ME"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="CHANGE_ME"
NEXT_PUBLIC_MOCK_PAYMENTS="false"

# ============================================================
# Sentry
# ============================================================
SENTRY_DSN="CHANGE_ME"
SENTRY_ORG="promptforge"
SENTRY_PROJECT="promptforge-studio"
SENTRY_AUTH_TOKEN="CHANGE_ME"
NEXT_PUBLIC_SENTRY_DSN="CHANGE_ME"

# ============================================================
# Elasticsearch
# ============================================================
ELASTICSEARCH_URL="CHANGE_ME"
ELASTICSEARCH_API_KEY="CHANGE_ME"

# ============================================================
# Email
# ============================================================
RESEND_API_KEY="CHANGE_ME"
EMAIL_FROM="PromptForge <noreply@promptforge.dev>"

# ============================================================
# Feature Flags
# ============================================================
NEXT_PUBLIC_MOCK_AI="false"
