# PromptForge Studio - Environment Variables Template
# Copy this file to .env.local and fill in real values

# ============================================================
# Application
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="PromptForge Studio"

# ============================================================
# Database (PostgreSQL recommended for production)
# ============================================================
DATABASE_URL="postgresql://user:password@localhost:5432/promptforge"

# ============================================================
# Authentication (NextAuth.js v5)
# ============================================================
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-32-byte-secret"
AUTH_URL="http://localhost:3000"

# Google OAuth (https://console.cloud.google.com/)
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# GitHub OAuth (https://github.com/settings/developers)
AUTH_GITHUB_ID="your-github-client-id"
AUTH_GITHUB_SECRET="your-github-client-secret"

# ============================================================
# AI Providers
# ============================================================
# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY="sk-..."

# Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY="sk-ant-..."

# Mock mode (set to true for local dev without AI costs)
USE_MOCK_AI="false"

# ============================================================
# Stripe (https://dashboard.stripe.com/apikeys)
# ============================================================
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ============================================================
# Sentry Error Tracking (https://sentry.io)
# ============================================================
SENTRY_DSN="https://...@sentry.io/..."
SENTRY_ORG="your-org"
SENTRY_PROJECT="promptforge-studio"
SENTRY_AUTH_TOKEN="your-auth-token"

# ============================================================
# Elasticsearch (optional - graceful fallback to Prisma if absent)
# ============================================================
ELASTICSEARCH_URL="http://localhost:9200"
ELASTICSEARCH_API_KEY="your-api-key"

# ============================================================
# Email (Resend recommended - https://resend.com)
# ============================================================
RESEND_API_KEY="re_..."
EMAIL_FROM="PromptForge <noreply@promptforge.dev>"

# ============================================================
# Feature Flags
# ============================================================
NEXT_PUBLIC_MOCK_PAYMENTS="false"
NEXT_PUBLIC_MOCK_AI="false"
